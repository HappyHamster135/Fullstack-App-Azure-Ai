<Project Sdk="Microsoft.NET.Sdk">

  <!-- Engångsverktyg för manuell helkörning: kör det riktiga API:t över HTTP mot SQLite. Ingår inte i lösningen. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <StartupObject>HarnessMain</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <ProjectReference Include="..\..\..\..\backend\SubTracker.Api\SubTracker.Api.csproj" />
  </ItemGroup>

  <!-- Pekar ut API-projektets mapp så att appsettings.Development.json (CORS för localhost:5173) hittas. -->
  <ItemGroup>
    <AssemblyAttribute Include="Microsoft.AspNetCore.Mvc.Testing.WebApplicationFactoryContentRoot">
      <_Parameter1>SubTracker.Api</_Parameter1>
      <_Parameter2>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\..\..\backend\SubTracker.Api'))</_Parameter2>
      <_Parameter3>SubTracker.Api.csproj</_Parameter3>
      <_Parameter4>0</_Parameter4>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
